{
  "name": "topbars",
  "version": "0.1.0",
  "description": "Extract top annotated bars from Spotify playlists via Genius API",
  "main": "dist/server.js",
  "bin": {
    "topbars-playlist": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts"
  },
  "keywords": [
